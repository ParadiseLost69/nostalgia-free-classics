DATABASE_URL=             # e.g. "file:./dev.db" (SQLite, local) or a postgres:// URL
AUTH_SECRET=              # generate with: npx auth secret
AUTH_TRUST_HOST=          # "true" when self-hosting behind a proxy (or set AUTH_URL); not needed on Vercel
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ADMIN_EMAIL=              # used by seed script to create the admin user
AUTH_DEV_LOGIN=           # "true" enables an email-only dev sign-in (ignored in production)
SITE_URL=                 # public origin, e.g. https://nostalgiafree.example (defaults to http://localhost:3000)

# Prisma CLI reads .env, Next.js reads .env.local. Locally, keep both in sync.
